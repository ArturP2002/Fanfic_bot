# Telegram
BOT_TOKEN=your_telegram_bot_token

# PostgreSQL
POSTGRES_USER=ficbrain
POSTGRES_PASSWORD=ficbrain_secret
POSTGRES_DB=ficbrain
# Локальный запуск (python app/main.py): localhost.
# docker compose для bot/worker сам подставит хосты postgres/redis.
DATABASE_URL=postgresql+asyncpg://ficbrain:ficbrain_secret@localhost:5433/ficbrain

# Redis / очередь
REDIS_URL=redis://localhost:6379/0

# OpenAI (Whisper + OCR Vision + извлечение названий)
OPENAI_API_KEY=your_openai_api_key
OPENAI_VISION_MODEL=gpt-4o-mini

# Apify (скачивание Instagram / TikTok)
APIFY_TOKEN=your_apify_token
APIFY_INSTAGRAM_ACTOR=apify/instagram-reel-scraper
APIFY_TIKTOK_ACTOR=clockworks/tiktok-scraper

# Параметры обработки видео
VIDEO_MAX_FRAMES=12
WHISPER_LANGUAGE=ru

# Логирование
LOG_LEVEL=INFO

# Админы (telegram id через запятую, опционально)
ADMIN_TELEGRAM_IDS=

# SOCKS5-прокси для исходящих запросов (VPS в РФ).
# Нужен для Telegram API, OpenAI, AO3/Ficbook, yt-dlp / Instagram.
# Примеры:
#   SOCKS5_PROXY=socks5h://user:pass@1.2.3.4:1080
#   SOCKS5_PROXY=socks5h://1.2.3.4:1080
# Пусто = без прокси (локальная разработка).
SOCKS5_PROXY=

# --- Подписка / ЮKassa ---
# Тестовые ключи магазина для прохождения проверок ЮKassa.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# true = тестовый режим.
# Без ключей ЮKassa — демо-оплата в боте (без списания денег).
# С тестовыми ключами — реальные тестовые платежи ЮKassa.
YOOKASSA_TEST_MODE=true
# Цена годовой подписки в рублях
SUBSCRIPTION_PRICE_RUB=299
SUBSCRIPTION_PERIOD_DAYS=365
# Бесплатных разборов роликов/скринов/LLM до подписки.
# 0 = жёсткий paywall (сразу нужна оплата).
FREE_TRIAL_USES=3

# --- Google Sheets (промокоды блогеров / атрибуции) ---
# Путь к JSON service account (относительно корня проекта или абсолютный).
# Таблицу расшарь на client_email из JSON (Редактор).
# Листы: «Промокоды», «Атрибуции» — создаются автоматически.
GOOGLE_SERVICE_ACCOUNT_JSON=credentials.json
GOOGLE_SHEETS_SPREADSHEET_ID=

# Сколько внешних поисков AO3/Ficbook на один пакет названий
PLATFORM_SEARCH_BUDGET=15
